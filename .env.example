# ───────────────────────── NONO backend — copy to .env ─────────────────────────
NONO_HOST=0.0.0.0
NONO_PORT=8000
# Optional: protect the API (frontend sends it as X-Nono-Key). Leave empty on localhost.
NONO_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
NONO_DATA_DIR=./data

# Who NONO serves
USER_NAME=Boss
TIMEZONE=Asia/Dhaka
# en-US | bn-BD  (speech recognition + reply language hint)
LANGUAGE=en-US

# ── LLM providers (all optional — add any free keys you have) ──
# OpenRouter: free models (50 req/day on free tier; 1000/day after a one-time $10 credit)
OPENROUTER_API_KEY=
# Groq: free & very fast — https://console.groq.com/keys  (also enables Whisper speech-to-text)
GROQ_API_KEY=
# Hugging Face Inference Providers — https://huggingface.co/settings/tokens
HF_TOKEN=
# OpenAI (ChatGPT) — https://platform.openai.com/api-keys
OPENAI_API_KEY=
# Google Gemini free tier — https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Local models via Ollama (100% free, offline) — https://ollama.com
OLLAMA_BASE_URL=http://localhost:11434

DEFAULT_PROVIDER=openrouter
DEFAULT_MODEL=openrouter/free

# ── Voice ──
ELEVENLABS_API_KEY=
# eleven_flash_v2_5 (fast, 32 languages incl. Bangla) | eleven_multilingual_v2 | eleven_v3
ELEVENLABS_MODEL=eleven_flash_v2_5
# prime | aria | titan | nova | echo
DEFAULT_VOICE=prime

# ── Integrations ──
# Telegram: create a bot with @BotFather, paste the token, then send "/pair <code>" to your bot
TELEGRAM_BOT_TOKEN=
# Optional: pre-authorise your chat id (otherwise pair from the bot)
TELEGRAM_CHAT_ID=
# Google Calendar: put OAuth client file at data/credentials.json and run scripts/google_auth.py
GOOGLE_CALENDAR_ID=primary

# ── RAG agent (long-term memory) ──
RAG_URL=http://localhost:8100
RAG_API_KEY=
